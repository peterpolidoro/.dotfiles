#!/bin/sh
# Generated from Systems.org. Mount the Janelia sciserv$ SMB share using the
# HHMI password from pass; nothing is written to disk.
set -eu

share='//prfs.hhmi.org/sciserv$'
mount_point='/janelia/sciserv'
pass_entry='web/hhmi.okta.com'
smb_user='polidorop'
smb_domain='HHMI'

usage() { echo 'Usage: mount-sciserv [-u]   (-u unmounts)'; }

case "${1:-}" in
    -u|--unmount) sudo umount "$mount_point"; echo "Unmounted $mount_point"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    '') ;;
    *) usage >&2; exit 2 ;;
esac

if grep -qs " $mount_point cifs " /proc/mounts; then
    echo "$mount_point is already mounted"
    exit 0
fi

# sudo's secure_path hides Guix profiles: resolve mount.cifs here and give sudo
# the absolute path. Guix cifs-utils first, Debian's cifs-utils as fallback.
mount_cifs=''
for candidate in "$(command -v mount.cifs 2>/dev/null || true)" \
                 "$HOME/.guix-extra-profiles/desktop/desktop/sbin/mount.cifs" \
                 /sbin/mount.cifs; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        mount_cifs="$candidate"
        break
    fi
done
if [ -z "$mount_cifs" ]; then
    echo 'mount.cifs not found: add cifs-utils to the Guix desktop manifest or run: sudo apt install cifs-utils' >&2
    exit 1
fi

# Read the password before calling sudo so pinentry and the sudo prompt do not
# overlap. Only the first line of the pass entry is the password.
password="$(pass show "$pass_entry" | head -n1)"
if [ -z "$password" ]; then
    echo "Could not read a password from pass entry $pass_entry" >&2
    exit 1
fi

sudo mkdir -p "$mount_point"
# printf is a shell builtin, so the password never appears in the process list.
printf '%s\n' "$password" \
    | sudo env PASSWD_FD=0 "$mount_cifs" "$share" "$mount_point" \
        -o "username=$smb_user,domain=$smb_domain,uid=$(id -u),gid=$(id -g),file_mode=0664,dir_mode=0775" \
    || { echo "Failed to mount $mount_point" >&2; exit 1; }
echo "Mounted $share at $mount_point"

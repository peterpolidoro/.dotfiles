#!/bin/sh
# Generated from Systems.org. Mount the Janelia sciserv$ SMB share through GVFS
# using the HHMI password from pass; no root, nothing written to disk.
set -eu

share_url='smb://prfs.hhmi.org/sciserv$'
gvfs_dir="/run/user/$(id -u)/gvfs/smb-share:server=prfs.hhmi.org,share=sciserv\$"
link="$HOME/sciserv"
pass_entry='web/hhmi.okta.com'
smb_user='polidorop'
smb_domain='HHMI'

usage() { echo 'Usage: mount-sciserv [-u]   (-u unmounts and removes ~/sciserv)'; }

case "${1:-}" in
    -u|--unmount)
        gio mount -u "$share_url"
        [ -L "$link" ] && rm -f "$link"
        echo "Unmounted $share_url"
        exit 0 ;;
    -h|--help) usage; exit 0 ;;
    '') ;;
    *) usage >&2; exit 2 ;;
esac

if [ -d "$gvfs_dir" ]; then
    echo "$share_url is already mounted"
else
    # Only the first line of the pass entry is the password.
    password="$(pass show "$pass_entry" | head -n1)"
    if [ -z "$password" ]; then
        echo "Could not read a password from pass entry $pass_entry" >&2
        exit 1
    fi
    # gio reads user, domain and password from stdin; printf is a shell
    # builtin, so the password never appears in the process list.
    printf '%s\n%s\n%s\n' "$smb_user" "$smb_domain" "$password" \
        | gio mount "$share_url" >/dev/null \
        || { echo "Failed to mount $share_url" >&2; exit 1; }
    echo "Mounted $share_url"
fi

# Convenience link; only touch it if it is absent or already a symlink.
if [ ! -e "$link" ] || [ -L "$link" ]; then
    ln -sfn "$gvfs_dir" "$link"
fi
echo "$link -> $gvfs_dir"

#!/bin/sh
# Generated from Systems.org.
set -eu
. "$(dirname "$(readlink -f "$0")")/../libexec/upgrade-common.sh"

upgrade_usage() { echo 'Usage: upgrade-guix-root [--dry-run]'; }
upgrade_parse "$@"
upgrade_no_profiles
upgrade_no_root_option
upgrade_system_kind
[ "$UPGRADE_SYSTEM_KIND" = debian ] || upgrade_die 'On Guix System, update the daemon through upgrade-system.'

# Root keeps its own Guix channels; this is separate from the user's pin set.
upgrade_child setup-guix-apparmor
upgrade_run sudo -i guix pull
upgrade_child setup-guix-apparmor
printf '%s\n' 'Root Guix update does not restart the daemon.' \
    'Restart guix-daemon from a clean TTY or after leaving the Guix-backed desktop.'

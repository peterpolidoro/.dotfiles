#!/bin/sh
# Generated from Systems.org.
set -eu
. "$(dirname "$(readlink -f "$0")")/../libexec/upgrade-common.sh"

upgrade_usage() { echo 'Usage: activate-profiles [--dry-run] PROFILE ...'; }
upgrade_parse "$@"
upgrade_no_root_option
[ -n "$UPGRADE_NAMES" ] || upgrade_die 'Name the profiles to activate, for example: activate-profiles desktop emacs'
upgrade_child upgrade-profiles $UPGRADE_NAMES
printf '%s\n' 'Open a new login session to load activated profiles into its environment.'

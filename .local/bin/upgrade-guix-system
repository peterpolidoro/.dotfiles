#!/bin/sh
# Generated from Systems.org.
set -eu
. "$(dirname "$(readlink -f "$0")")/../libexec/upgrade-common.sh"

upgrade_usage() { echo 'Usage: upgrade-guix-system [--dry-run] (legacy OS + root Guix update)'; }
upgrade_parse "$@"
upgrade_no_profiles
upgrade_no_root_option
upgrade_child upgrade-system
upgrade_system_kind
if [ "$UPGRADE_SYSTEM_KIND" = debian ]; then
    upgrade_child upgrade-guix-root
fi
